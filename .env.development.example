# Desenvolvimento: copie para .env.development sem alterar. Segredos inseguros de propósito.

# Origem do Vite; usada nos links de e-mail e na checagem de origem (CSRF). Obrigatória.
URL_APP=http://localhost:5173
# Nome exibido aos clientes. Obrigatório.
NOME_NEGOCIO=Nome Provisório
# Versão dos termos aceitos no cadastro; aumente quando o texto mudar. Obrigatória.
VERSAO_TERMOS=1
# Porta do servidor. Opcional (padrão 3000).
PORT=3100
# true só atrás de proxy reverso. Opcional (padrão false).
CONFIAR_PROXY=false
# Segredo das sessões, mínimo 32 caracteres. Obrigatório.
SEGREDO_SESSAO=desenvolvimento-inseguro-nao-use-em-producao-0000
# 32 bytes em base64, para criptografar tokens do Google. Obrigatória.
CHAVE_CRIPTOGRAFIA=aW5zZWd1cm8tY2hhdmUtZGV2LTAxMjM0NTY3ODlhYmM=

# Banco local do docker-compose.dev.yml. Obrigatória.
URL_BANCO=postgres://jev:jev_dev_inseguro@localhost:5433/jev_dev
# Banco só dos testes; não pode existir em produção.
URL_BANCO_TESTES=postgres://jev:jev_dev_inseguro@localhost:5433/jev_teste

# log ou smtp. Obrigatória.
PROVEDOR_EMAIL=log
# Só com PROVEDOR_EMAIL=smtp.
SMTP_SERVIDOR=
SMTP_PORTA=
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=

# true usa o Jev simulado, sem chave.
JEV_SIMULADO=true
# Chave da TypeSafe AI; só com JEV_SIMULADO=false.
CHAVE_API_TYPESAFE=
JEV_MODELO=jev-1.13.0
JEV_CONCORRENCIA=10
# USD por milhão de tokens.
JEV_PRECO_POR_MTOK=0.042

# anthropic ou mock.
LLM_PROVEDOR=mock
# Só com LLM_PROVEDOR=anthropic; preços em USD por milhão de tokens.
LLM_CHAVE_API=
LLM_MODELO=
LLM_PRECO_ENTRADA_POR_MTOK=
LLM_PRECO_SAIDA_POR_MTOK=
LLM_RESUMO_MAX_TOKENS=1200
# Probabilidade mínima (0 a 1) para um número do resumo contar como sustentado.
RESUMO_LIMIAR_SUSTENTACAO=0.7

PERGUNTAR_MAX_COMENTARIOS=5000

# true usa dados fictícios do Google.
GOOGLE_EMPRESA_SIMULADO=true
# Credenciais do Google Cloud; só com GOOGLE_EMPRESA_SIMULADO=false.
GOOGLE_ID_CLIENTE=
GOOGLE_SEGREDO_CLIENTE=
GOOGLE_URI_REDIRECIONAMENTO=http://localhost:3100/api/google/callback
GOOGLE_INTERVALO_SINCRONIZACAO_HORAS=24

PLANO_PADRAO_ID=trial
# No MVP, sempre false.
COBRANCA_ATIVADA=false

# Origens liberadas na CSP, separadas por vírgula.
ORIGENS_ESTILO_EXTERNO=https://fonts.googleapis.com
ORIGENS_FONTE_EXTERNA=https://fonts.gstatic.com
