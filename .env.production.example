# Produção: copie para .env.production e preencha os vazios. Modo simulado, log e http são recusados.

# Origem pública do app, com https. Obrigatória.
URL_APP=https://app.exemplo.com.br
# Origem do site público (landing e blog), no domínio principal; https e host diferente de URL_APP.
URL_SITE=https://exemplo.com.br
# Nome exibido aos clientes. Obrigatório.
NOME_NEGOCIO=
# Versão dos termos aceitos no cadastro; aumente quando o texto mudar. Obrigatória.
VERSAO_TERMOS=1
PORT=3000
# true atrás de proxy reverso, que também precisa repassar o Host original.
CONFIAR_PROXY=true
# Mínimo 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SEGREDO_SESSAO=
# 32 bytes em base64. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVE_CRIPTOGRAFIA=

# Usuário sem privilégio de superusuário. Backup é do operador. Obrigatória.
URL_BANCO=postgres://usuario:senha@host:5432/banco

# Em produção, smtp.
PROVEDOR_EMAIL=smtp
# Dados do seu provedor de e-mail. Obrigatórios com smtp.
SMTP_SERVIDOR=
SMTP_PORTA=
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=

# Em produção, sempre false.
JEV_SIMULADO=false
# Chave do painel da TypeSafe AI. Obrigatória.
CHAVE_API_TYPESAFE=
JEV_MODELO=jev-1.13.0
JEV_CONCORRENCIA=10
# USD por milhão de tokens.
JEV_PRECO_POR_MTOK=0.042

# Em produção, anthropic.
LLM_PROVEDOR=anthropic
# Chave do console da Anthropic, modelo e preços em USD por milhão de tokens. Obrigatórios.
LLM_CHAVE_API=
LLM_MODELO=
LLM_PRECO_ENTRADA_POR_MTOK=
LLM_PRECO_SAIDA_POR_MTOK=
LLM_RESUMO_MAX_TOKENS=1200
# Probabilidade mínima (0 a 1) para um número do resumo contar como sustentado.
RESUMO_LIMIAR_SUSTENTACAO=0.7

PERGUNTAR_MAX_COMENTARIOS=5000

# Em produção, sempre false.
GOOGLE_EMPRESA_SIMULADO=false
# Credenciais OAuth do Google Cloud (APIs e serviços > Credenciais). Obrigatórias.
GOOGLE_ID_CLIENTE=
GOOGLE_SEGREDO_CLIENTE=
# Mesma URL cadastrada no cliente OAuth, com https.
GOOGLE_URI_REDIRECIONAMENTO=https://app.exemplo.com.br/api/google/callback
GOOGLE_INTERVALO_SINCRONIZACAO_HORAS=24

PLANO_PADRAO_ID=trial
# No MVP, sempre false.
COBRANCA_ATIVADA=false

# Origens liberadas na CSP, separadas por vírgula.
ORIGENS_ESTILO_EXTERNO=https://fonts.googleapis.com
ORIGENS_FONTE_EXTERNA=https://fonts.gstatic.com
